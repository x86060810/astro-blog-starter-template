---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="夏士博的网站 - 一人自治管理有限公司" description="夏士博的个人网站，展示技术专长和职业历程" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  </head>
  <body class="bg-gray-50">
    <!-- 导航栏 -->
    <nav class="bg-gradient-to-r from-blue-500 to-purple-600 shadow-lg">
      <div class="container mx-auto px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="text-white font-bold text-xl">
            夏士博的网站
          </div>
          <div class="hidden md:flex space-x-8">
            <a href="/" class="text-white hover:text-gray-200">首页</a>
            <a href="/blog" class="text-white hover:text-gray-200">文章</a>
            <a href="/about" class="text-white hover:text-gray-200">关于我</a>
          </div>
          <div class="md:hidden">
            <button class="mobile-menu-button text-white focus:outline-none">
              <i class="fas fa-bars text-2xl"></i>
            </button>
          </div>
        </div>
      </div>
      <!-- 移动端菜单 -->
      <div class="mobile-menu hidden md:hidden bg-blue-700">
        <a href="/" class="block py-2 px-4 text-white hover:bg-blue-600">首页</a>
        <a href="/blog" class="block py-2 px-4 text-white hover:bg-blue-600">文章</a>
        <a href="/about" class="block py-2 px-4 text-white hover:bg-blue-600">关于我</a>
      </div>
    </nav>

    <!-- 主要内容 -->
    <main class="container mx-auto px-6 py-8">
      <!-- 欢迎区域 -->
      <section class="mb-12">
        <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg shadow-md p-12 text-white text-center">
          <h1 class="text-4xl font-bold mb-4">欢迎来到夏士博的网站</h1>
          <p class="text-xl mb-8">一人自治管理有限公司 | 技术专家 · 商业价值创造者 · 自媒体运营师</p>
          <div class="flex justify-center space-x-4">
            <a href="/about" class="bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
              <i class="fas fa-user mr-2"></i>了解我
            </a>
            <a href="/blog" class="bg-transparent border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition">
              <i class="fas fa-book mr-2"></i>查看文章
            </a>
          </div>
        </div>
      </section>

      <!-- 核心优势预览 -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold text-gray-800 mb-6 text-center">核心优势</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg shadow-md">
            <div class="text-blue-600 text-3xl mb-4">
              <i class="fas fa-laptop-code"></i>
            </div>
            <h3 class="text-xl font-medium text-blue-700 mb-3">复合型技术专家</h3>
            <p class="text-gray-700">
              16 年 + 全栈 IT 运维经验，精通企业级 IT 基础设施全生命周期管理。
            </p>
          </div>
          <div class="bg-purple-50 p-6 rounded-lg shadow-md">
            <div class="text-purple-600 text-3xl mb-4">
              <i class="fas fa-chart-line"></i>
            </div>
            <h3 class="text-xl font-medium text-purple-700 mb-3">商业价值创造者</h3>
            <p class="text-gray-700">
              独特的「技术 + 销售」双向思维，为企业提供高 ROI 的 IT 运维服务。
            </p>
          </div>
          <div class="bg-yellow-50 p-6 rounded-lg shadow-md">
            <div class="text-yellow-600 text-3xl mb-4">
              <i class="fas fa-users"></i>
            </div>
            <h3 class="text-xl font-medium text-yellow-700 mb-3">自媒体运营师</h3>
            <p class="text-gray-700">
              独立运营微信公众号，从 0 起号实现 10000 粉丝精准增长。
            </p>
          </div>
        </div>
      </section>

      <!-- 快速链接 -->
      <section class="mb-12">
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6 text-center">探索更多</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a href="/about" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition">
              <div class="bg-blue-100 p-3 rounded-full mr-4">
                <i class="fas fa-user text-blue-600 text-xl"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800">关于我</h3>
                <p class="text-gray-600 text-sm">了解我的职业历程和技术专长</p>
              </div>
            </a>
            <a href="/blog" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition">
              <div class="bg-purple-100 p-3 rounded-full mr-4">
                <i class="fas fa-book text-purple-600 text-xl"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800">文章</h3>
                <p class="text-gray-600 text-sm">阅读我的技术分享和见解</p>
              </div>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- 页脚 -->
    <Footer />

    <script>
      // 移动端菜单切换
      const mobileMenuButton = document.querySelector('.mobile-menu-button');
      const mobileMenu = document.querySelector('.mobile-menu');
      
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
