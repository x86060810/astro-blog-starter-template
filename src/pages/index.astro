---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="夏士博的网站 - 一人自治管理有限公司" description="夏士博的个人网站，展示技术专长和职业历程" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  </head>
  <body class="bg-gray-50">
    <!-- 导航栏 -->
    <nav class="bg-gradient-to-r from-blue-500 to-purple-600 shadow-lg">
      <div class="container mx-auto px-4 sm:px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="text-white font-bold text-lg sm:text-xl">
            夏士博的网站
          </div>
          <div class="hidden md:flex space-x-8">
            <a href="/" class="text-white hover:text-gray-200">首页</a>
            <a href="/blog" class="text-white hover:text-gray-200">文章</a>
            <a href="/about" class="text-white hover:text-gray-200">关于我</a>
          </div>
          <div class="md:hidden">
            <button class="mobile-menu-button text-white focus:outline-none p-2" aria-label="打开菜单">
              <i class="fas fa-bars text-2xl"></i>
            </button>
          </div>
        </div>
      </div>
      <!-- 移动端菜单 -->
      <div class="mobile-menu hidden md:hidden bg-blue-700">
        <a href="/" class="block py-3 px-5 text-white hover:bg-blue-600">首页</a>
        <a href="/blog" class="block py-3 px-5 text-white hover:bg-blue-600">文章</a>
        <a href="/about" class="block py-3 px-5 text-white hover:bg-blue-600">关于我</a>
      </div>
    </nav>

    <!-- 主要内容 -->
    <main class="container mx-auto px-4 sm:px-6 py-8">
      <!-- 欢迎区域 -->
      <section class="mb-10 md:mb-12">
        <div class="hero-card">
          <h1 class="hero-title">欢迎来到夏士博的网站</h1>
          <p class="hero-sub">一人自治管理有限公司</p>
          <ul class="hero-tags">
            <li>技术专家</li>
            <li>商业价值创造者</li>
            <li>自媒体运营师</li>
          </ul>
          <div class="hero-actions">
            <a href="/about" class="hero-btn hero-btn-primary">
              <i class="fas fa-user" aria-hidden="true"></i>了解我
            </a>
            <a href="/blog" class="hero-btn hero-btn-ghost">
              <i class="fas fa-book" aria-hidden="true"></i>查看文章
            </a>
          </div>
        </div>
      </section>

      <!-- 核心优势预览 -->
      <section class="mb-10 md:mb-12">
        <h2 class="section-title">核心优势</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
          <div class="bg-blue-50 p-5 md:p-6 rounded-lg shadow-md">
            <div class="text-blue-600 text-3xl mb-4">
              <i class="fas fa-laptop-code" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg md:text-xl font-medium text-blue-700 mb-3">复合型技术专家</h3>
            <p class="text-gray-700 text-base leading-relaxed">
              16 年 + 全栈 IT 运维经验，精通企业级 IT 基础设施全生命周期管理。
            </p>
          </div>
          <div class="bg-purple-50 p-5 md:p-6 rounded-lg shadow-md">
            <div class="text-purple-600 text-3xl mb-4">
              <i class="fas fa-chart-line" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg md:text-xl font-medium text-purple-700 mb-3">商业价值创造者</h3>
            <p class="text-gray-700 text-base leading-relaxed">
              独特的「技术 + 销售」双向思维，为企业提供高 ROI 的 IT 运维服务。
            </p>
          </div>
          <div class="bg-yellow-50 p-5 md:p-6 rounded-lg shadow-md">
            <div class="text-yellow-600 text-3xl mb-4">
              <i class="fas fa-users" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg md:text-xl font-medium text-yellow-700 mb-3">自媒体运营师</h3>
            <p class="text-gray-700 text-base leading-relaxed">
              独立运营微信公众号，从 0 起号实现 10000 粉丝精准增长。
            </p>
          </div>
        </div>
      </section>

      <!-- 快速链接 -->
      <section class="mb-10 md:mb-12">
        <div class="bg-white rounded-lg shadow-md p-5 md:p-8">
          <h2 class="section-title">探索更多</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            <a href="/about" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition">
              <div class="flex-shrink-0 bg-blue-100 p-3 rounded-full mr-4">
                <i class="fas fa-user text-blue-600 text-xl" aria-hidden="true"></i>
              </div>
              <div class="min-w-0">
                <h3 class="quick-title">关于我</h3>
                <p class="text-gray-600 text-sm leading-relaxed">了解我的职业历程和技术专长</p>
              </div>
            </a>
            <a href="/blog" class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition">
              <div class="flex-shrink-0 bg-purple-100 p-3 rounded-full mr-4">
                <i class="fas fa-book text-purple-600 text-xl" aria-hidden="true"></i>
              </div>
              <div class="min-w-0">
                <h3 class="quick-title">文章</h3>
                <p class="text-gray-600 text-sm leading-relaxed">阅读我的技术分享和见解</p>
              </div>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- 页脚 -->
    <Footer />

    <script>
      const mobileMenuButton = document.querySelector('.mobile-menu-button');
      const mobileMenu = document.querySelector('.mobile-menu');
      mobileMenuButton?.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    </script>
  </body>
</html>

<style>
  .hero-card {
    background: linear-gradient(90deg, #3b82f6 0%, #7c3aed 100%);
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    color: #fff;
    text-align: center;
    padding: 3rem;
  }
  .hero-title {
    color: #fff;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.28;
    margin: 0 0 1rem;
  }
  .hero-sub {
    color: #fff;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
    opacity: 0.95;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    font-size: 1rem;
  }
  .hero-tags li {
    white-space: nowrap;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .hero-btn-primary {
    background: #fff;
    color: #2563eb;
  }
  .hero-btn-primary:hover {
    background: #f3f4f6;
    color: #2563eb;
  }
  .hero-btn-ghost {
    background: transparent;
    border: 2px solid #fff;
    color: #fff;
  }
  .hero-btn-ghost:hover {
    background: #fff;
    color: #2563eb;
  }
  .quick-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 0.25rem;
    line-height: 1.4;
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: #1f2937;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  @media (max-width: 640px) {
    main.container {
      width: 100%;
      max-width: 100%;
      padding: 1.25rem 1rem 2rem;
    }
    .hero-card {
      padding: 1.75rem 1.25rem 2rem;
    }
    .hero-title {
      font-size: 1.6rem;
      line-height: 1.35;
      margin-bottom: 0.75rem;
    }
    .hero-sub {
      font-size: 0.95rem;
      margin-bottom: 0.6rem;
    }
    .hero-tags {
      font-size: 0.875rem;
      gap: 0.3rem 0.75rem;
      margin-bottom: 1.4rem;
    }
    .hero-actions {
      flex-direction: column;
      gap: 0.75rem;
    }
    .hero-btn {
      width: 100%;
      padding: 0.8rem 1rem;
    }
    .section-title {
      font-size: 1.2rem;
      margin-bottom: 1.2rem;
    }
  }
</style>
