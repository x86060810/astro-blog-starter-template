---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="夏士博的网站 - 一人自治管理有限公司" description="夏士博的个人网站，展示技术专长和职业历程" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  </head>
  <body class="bg-gray-50">
    <!-- 导航栏 -->
    <nav class="bg-gradient-to-r from-blue-500 to-purple-600 shadow-lg">
      <div class="container mx-auto px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="text-white font-bold text-xl">
            夏士博的网站
          </div>
          <div class="hidden md:flex space-x-8">
            <a href="/" class="text-white hover:text-gray-200">首页</a>
            <a href="/blog" class="text-white hover:text-gray-200">文章</a>
            <a href="/about" class="text-white hover:text-gray-200">联系我</a>
          </div>
          <div class="md:hidden">
            <button class="mobile-menu-button text-white focus:outline-none">
              <i class="fas fa-bars text-2xl"></i>
            </button>
          </div>
        </div>
      </div>
      <!-- 移动端菜单 -->
      <div class="mobile-menu hidden md:hidden bg-blue-700">
        <a href="/" class="block py-2 px-4 text-white hover:bg-blue-600">首页</a>
        <a href="/blog" class="block py-2 px-4 text-white hover:bg-blue-600">文章</a>
        <a href="/about" class="block py-2 px-4 text-white hover:bg-blue-600">联系我</a>
      </div>
    </nav>

    <!-- 主要内容 -->
    <main class="container mx-auto px-6 py-8">
      <section class="mb-12">
        <div class="bg-white rounded-lg shadow-md p-8">
          <div class="flex flex-col md:flex-row items-start">
            <div class="md:w-2/3 md:pl-8">
              <h1 class="text-3xl font-bold text-gray-800 mb-6">关于我</h1>
              
              <!-- 核心优势 -->
              <div class="mb-8">
                <h2 class="text-2xl font-semibold text-blue-600 mb-4 border-b border-blue-200 pb-2">核心优势</h2>
                <div class="space-y-4">
                  <div class="bg-blue-50 p-4 rounded-lg">
                    <h3 class="text-lg font-medium text-blue-700 mb-2">复合型技术专家</h3>
                    <p class="text-gray-700">
                      16年+全栈IT运维经验，精通企业级IT基础设施全生命周期管理，从桌面终端运维到云服务器集群部署，具备企业网络环境的架构设计与故障排查能力。
                    </p>
                  </div>
                  <div class="bg-purple-50 p-4 rounded-lg">
                    <h3 class="text-lg font-medium text-purple-700 mb-2">商业价值创造者</h3>
                    <p class="text-gray-700">
                      独特的「技术+销售」双向思维，擅长将技术方案转化为浅显语言，曾为中小企业至世界500强企业提供高ROI的IT运维服务。
                    </p>
                  </div>
                  <div class="bg-yellow-50 p-4 rounded-lg">
                    <h3 class="text-lg font-medium text-yellow-700 mb-2">自媒体运营师</h3>
                    <p class="text-gray-700">
                      独立运营微信公众号，从 0 起号实现 10000 粉丝精准增长，擅长内容创作、渠道引流与用户运营，打造高粘性粉丝社群，实现账号流量与影响力双提升。
                    </p>
                  </div>
                </div>
              </div>

              <!-- 职业里程碑 -->
              <div class="mb-8">
                <h2 class="text-2xl font-semibold text-blue-600 mb-4 border-b border-blue-200 pb-2">职业里程碑</h2>
                <div class="space-y-6">
                  <!-- 全球化IT服务 -->
                  <div>
                    <h3 class="text-xl font-medium text-gray-700 mb-3">全球化IT服务</h3>
                    <ul class="space-y-3 pl-5 list-disc text-gray-700">
                      <li>主导跨国企业亚洲IT架构标准化项目，实现全球分支机构的网络合规性100%达标</li>
                      <li>设计混合云部署方案为某外企降低35%运维成本</li>
                    </ul>
                  </div>
                  
                  <!-- 技术赋能销售 -->
                  <div>
                    <h3 class="text-xl font-medium text-gray-700 mb-3">技术赋能销售</h3>
                    <ul class="space-y-3 pl-5 list-disc text-gray-700">
                      <li>创建「技术可行性-商业价值」双维度评估体系，助力销售效率提升40%</li>
                      <li>部署ERP系统将客户分类进行突破，节约成本约60%</li>
                    </ul>
                  </div>
                  
                  <!-- 中小企业数字化转型 -->
                  <div>
                    <h3 class="text-xl font-medium text-gray-700 mb-3">中小企业数字化转型</h3>
                    <ul class="space-y-3 pl-5 list-disc text-gray-700">
                      <li>为中小企业设计阶梯式IT升级路线，平均节省初期投入50万元</li>
                      <li>创新「IT健康度评估模型」</li>
                    </ul>
                  </div>
                </div>
              </div>
              
              <!-- 技术矩阵 -->
              <div>
                <h2 class="text-2xl font-semibold text-blue-600 mb-4 border-b border-blue-200 pb-2">技术矩阵</h2>
                <div class="overflow-x-auto">
                  <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                    <thead>
                      <tr class="bg-gray-100">
                        <th class="py-3 px-4 border-b text-left font-medium text-gray-700">基础设施</th>
                        <th class="py-3 px-4 border-b text-left font-medium text-gray-700">网络架构</th>
                        <th class="py-3 px-4 border-b text-left font-medium text-gray-700">成本优化</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="py-3 px-4 border-b">• Windows/Linux混合运维</td>
                        <td class="py-3 px-4 border-b">• Cisco/JHUAWEI网络方案</td>
                        <td class="py-3 px-4 border-b">• 云成本TCO分析模型</td>
                      </tr>
                      <tr>
                        <td class="py-3 px-4 border-b">• 自动化运维体系搭建</td>
                        <td class="py-3 px-4 border-b">• SD-WAN跨国部署</td>
                        <td class="py-3 px-4 border-b">• ITIL服务流程再造</td>
                      </tr>
                      <tr>
                        <td class="py-3 px-4 border-b">• 计算机软硬件ERP维护</td>
                        <td class="py-3 px-4 border-b">• 零信任+DLP项目落地</td>
                        <td class="py-3 px-4 border-b">• 软件版权管理</td>
                      </tr>
                      <tr>
                        <td class="py-3 px-4 border-b">• 机房动环 / 灾备体系建设</td>
                        <td class="py-3 px-4 border-b">• 跨域网络互联互通规划</td>
                        <td class="py-3 px-4 border-b">• 软硬件资产全生命周期成本管控</td>
                      </tr>
                      <tr>
                        <td class="py-3 px-4 border-b">• 终端设备标准化管理</td>
                        <td class="py-3 px-4 border-b">• 网络安全纵深防御搭建</td>
                        <td class="py-3 px-4 border-b">• 开源技术替代与成本节约</td>
                      </tr>
                      <tr>
                        <td class="py-3 px-4 border-b">• 监控告警体系落地</td>
                        <td class="py-3 px-4 border-b"></td>
                        <td class="py-3 px-4 border-b"></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- 页脚 -->
    <footer class="bg-gray-800 text-white py-6">
      <div class="container mx-auto px-6 text-center">
        <p>© 2025 夏士博的网站. 保留所有权利.</p>
        <div class="flex justify-center space-x-6 mt-4">
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-github text-2xl"></i></a>
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-twitter text-2xl"></i></a>
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-linkedin text-2xl"></i></a>
        </div>
      </div>
    </footer>

    <script>
      // 移动端菜单切换
      const mobileMenuButton = document.querySelector('.mobile-menu-button');
      const mobileMenu = document.querySelector('.mobile-menu');
      
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    </script>
  </body>
</html>